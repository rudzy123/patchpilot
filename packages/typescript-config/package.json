{
  "name": "@patchpilot/typescript-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript compiler options for PatchPilot apps and packages.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./base.json": "./base.json",
    "./node.json": "./node.json",
    "./library.json": "./library.json",
    "./nextjs.json": "./nextjs.json"
  },
  "scripts": {
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "typecheck": "node --eval \"process.stdout.write('ok\\n')\"",
    "test:unit": "node --eval \"process.stdout.write('no unit tests\\n')\"",
    "clean": "node --eval \"process.exit(0)\""
  }
}
