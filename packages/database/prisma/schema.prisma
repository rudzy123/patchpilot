model OsvActivationRecord {
  id                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scopeFingerprint        String               @map("scope_fingerprint") @db.Char(64)
  candidateGenerationId   String               @map("candidate_generation_id") @db.Uuid
  previousGenerationId    String?              @map("previous_generation_id") @db.Uuid
  expectedPointerVersion  Int                  @map("expected_pointer_version")
  resultingPointerVersion Int?                 @map("resulting_pointer_version")
  activatedAt             DateTime             @map("activated_at") @db.Timestamptz(6)
  reasonCode              String               @map("reason_code") @db.VarChar(64)
  outcome                 OsvActivationOutcome
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  candidateGeneration OsvCatalogGeneration  @relation("OsvActivationCandidate", fields: [candidateGenerationId, scopeFingerprint], references: [id, scopeFingerprint], onDelete: Restrict)
  previousGeneration  OsvCatalogGeneration? @relation("OsvActivationPrevious", fields: [previousGenerationId], references: [id], onDelete: Restrict)

  @@index([scopeFingerprint, activatedAt], map: "osv_activation_record_scope_time_idx")
  @@map("osv_activation_record")
}

/// Session 12 Batch 6 / 6-R OSV runtime coordination persistence. Global,
/// instance-owned provider-runtime state. No tenant, Finding, catalog-activation,
/// or BackgroundJob/Outbox coupling. Schema only; no lease or retry adapters.
/// Request rows are append-only. Lease projection is one durable row per scope;
/// DELETE is forbidden so fencing tokens cannot reset. Attempt identity is
/// immutable; planned or running may transition once to a terminal state.
/// Digests are TEXT with exact lowercase SHA-256 CHECKs. CHAR/VARCHAR(64) would
/// silently truncate extra trailing spaces.
model OsvRuntimeSynchronizationRequest {
  id                     String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobType                String                          @map("job_type") @db.VarChar(128)
  jobSchemaVersion       String                          @map("job_schema_version") @db.VarChar(128)
  synchronizationReason  OsvRuntimeSynchronizationReason @map("synchronization_reason")
  workScope              OsvRuntimeWorkScope             @map("work_scope")
  leaseScope             String                          @map("lease_scope") @db.VarChar(128)
  catalogScope           String                          @map("catalog_scope") @db.VarChar(128)
  versionSetFingerprint  String                          @map("version_set_fingerprint") @db.Text
  requestedAt            DateTime                        @map("requested_at") @db.Timestamptz(6)
  correlationId          String                          @map("correlation_id") @db.Uuid
  canaryPolicyIdentifier String?                         @map("canary_policy_identifier") @db.VarChar(128)
  requestKind            OsvRuntimeJobRequestKind        @map("request_kind")
  schedulerWindowId      String?                         @map("scheduler_window_id") @db.VarChar(128)
  operatorRequestId      String?                         @map("operator_request_id") @db.Uuid
  requestState           OsvRuntimeJobRequestState       @map("request_state")
  createdAt              DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)

  runs                                         OsvRuntimeSynchronizationRun[]
  consumedCanaryAuthorizations                 OsvCanaryAuthorization[]                    @relation("OsvCanaryAuthorizationConsumedRequest")
  listingReviewCanaryAuthorizations            OsvCanaryAuthorization[]                    @relation("OsvCanaryAuthorizationListingRequest")
  listingProviderContactAuthorizations         OsvListingProviderContactAuthorization[]    @relation("OsvListingProviderContactRequest")
  consumedListingProviderContactAuthorizations OsvListingProviderContactAuthorization[]    @relation("OsvListingProviderContactConsumedRequest")
  providerFreePreflightAttestations            OsvCanaryProviderFreePreflightAttestation[] @relation("OsvCanaryProviderFreePreflightRequest")
  listingObservationEvidenceSets               OsvListingObservationEvidenceSet[]          @relation("OsvListingObservationEvidenceSetRequest")

  @@unique([id, workScope, synchronizationReason, versionSetFingerprint, leaseScope], map: "osv_runtime_sync_request_pin_key")
  @@unique([operatorRequestId], map: "osv_runtime_sync_request_operator_uidx")
  @@index([correlationId], map: "osv_runtime_sync_request_correlation_idx")
  @@index([requestedAt], map: "osv_runtime_sync_request_requested_idx")
  @@map("osv_runtime_synchronization_request")
}

model OsvRuntimeSynchronizationRun {
  id                                 String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId                          String                          @map("request_id") @db.Uuid
  workScope                          OsvRuntimeWorkScope             @map("work_scope")
  leaseScope                         String                          @map("lease_scope") @db.VarChar(128)
  synchronizationReason              OsvRuntimeSynchronizationReason @map("synchronization_reason")
  paginationPolicyIdentifier         String                          @map("pagination_policy_identifier") @db.VarChar(128)
  versionSetFingerprint              String                          @map("version_set_fingerprint") @db.Text
  runtimeArchitectureIdentifier      String                          @map("runtime_architecture_identifier") @db.VarChar(128)
  synchronizationAlgorithmIdentifier String                          @map("synchronization_algorithm_identifier") @db.VarChar(128)
  retryPolicyIdentifier              String                          @map("retry_policy_identifier") @db.VarChar(128)
  state                              OsvRuntimeRunState
  startedAt                          DateTime?                       @map("started_at") @db.Timestamptz(6)
  terminalAt                         DateTime?                       @map("terminal_at") @db.Timestamptz(6)
  terminalCode                       String?                         @map("terminal_code") @db.VarChar(64)
  retryDisposition                   OsvRuntimeRetryEligibility?     @map("retry_disposition")
  lastAcceptedStage                  OsvRuntimeRetryableStage?       @map("last_accepted_stage")
  cancellationBoundary               String?                         @map("cancellation_boundary") @db.VarChar(64)
  createdAt                          DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                          DateTime                        @map("updated_at") @db.Timestamptz(6)

  request                                      OsvRuntimeSynchronizationRequest            @relation(fields: [requestId, workScope, synchronizationReason, versionSetFingerprint, leaseScope], references: [id, workScope, synchronizationReason, versionSetFingerprint, leaseScope], onDelete: Restrict)
  leases                                       OsvRuntimeLeaseProjection[]
  attempts                                     OsvRuntimeStageAttempt[]
  consumedCanaryAuthorizations                 OsvCanaryAuthorization[]                    @relation("OsvCanaryAuthorizationConsumedRun")
  listingReviewCanaryAuthorizations            OsvCanaryAuthorization[]                    @relation("OsvCanaryAuthorizationListingRun")
  listingProviderContactAuthorizations         OsvListingProviderContactAuthorization[]    @relation("OsvListingProviderContactRun")
  consumedListingProviderContactAuthorizations OsvListingProviderContactAuthorization[]    @relation("OsvListingProviderContactConsumedRun")
  providerFreePreflightAttestations            OsvCanaryProviderFreePreflightAttestation[] @relation("OsvCanaryProviderFreePreflightRun")
  listingObservationEvidenceSets               OsvListingObservationEvidenceSet[]          @relation("OsvListingObservationEvidenceSetRun")

  @@unique([requestId], map: "osv_runtime_sync_run_request_uidx")
  @@unique([id, requestId], map: "osv_runtime_sync_run_id_request_uidx")
  @@index([workScope, state], map: "osv_runtime_sync_run_scope_state_idx")
  @@index([versionSetFingerprint], map: "osv_runtime_sync_run_fingerprint_idx")
  @@index([state, createdAt], map: "osv_runtime_sync_run_state_created_idx")
  @@map("osv_runtime_synchronization_run")
}

/// Current acquisition-lease projection. Absent means no row. Expired is derived
/// from database time and expiresAt, not a stored state. Holder token is digest
/// only. rowRevision increments on every mutation; fencingToken increments on
/// new ownership, stale takeover, and release, not heartbeat.
model OsvRuntimeLeaseProjection {
  scope             String                         @id @map("scope") @db.VarChar(128)
  runId             String                         @map("run_id") @db.Uuid
  holderTokenDigest String                         @map("holder_token_digest") @db.Text
  rowRevision       BigInt                         @map("row_revision")
  fencingToken      BigInt                         @map("fencing_token")
  state             OsvRuntimeLeaseProjectionState
  acquiredAt        DateTime                       @map("acquired_at") @db.Timestamptz(6)
  heartbeatAt       DateTime                       @map("heartbeat_at") @db.Timestamptz(6)
  expiresAt         DateTime                       @map("expires_at") @db.Timestamptz(6)
  releasedAt        DateTime?                      @map("released_at") @db.Timestamptz(6)
  releaseReason     OsvRuntimeLeaseReleaseReason?  @map("release_reason")
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                       @map("updated_at") @db.Timestamptz(6)

  run OsvRuntimeSynchronizationRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId], map: "osv_runtime_lease_projection_run_idx")
  @@index([expiresAt], map: "osv_runtime_lease_projection_expires_idx")
  @@map("osv_runtime_lease_projection")
}

/// Immutable attempt identity (run, stage, optional target digest, ordinal).
/// planned/running may be updated to one terminal state. Terminal rows cannot
/// change. DELETE is forbidden. Retry-not-before is constructed by a future
/// adapter from database time plus selected delay, never caller absolute time.
model OsvRuntimeStageAttempt {
  id                    String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId                 String                     @map("run_id") @db.Uuid
  stage                 OsvRuntimeRetryableStage
  targetIdentityDigest  String?                    @map("target_identity_digest") @db.Text
  attemptOrdinal        Int                        @map("attempt_ordinal")
  retryPolicyIdentifier String                     @map("retry_policy_identifier") @db.VarChar(128)
  state                 OsvRuntimeAttemptState
  startedAt             DateTime?                  @map("started_at") @db.Timestamptz(6)
  terminalAt            DateTime?                  @map("terminal_at") @db.Timestamptz(6)
  failureCode           String?                    @map("failure_code") @db.VarChar(64)
  failureCatalog        String?                    @map("failure_catalog") @db.VarChar(32)
  retryDisposition      OsvRuntimeRetryEligibility @map("retry_disposition")
  nominalDelayMs        Int                        @map("nominal_delay_ms")
  selectedDelayMs       Int                        @map("selected_delay_ms")
  retryNotBefore        DateTime?                  @map("retry_not_before") @db.Timestamptz(6)
  retryExhausted        Boolean                    @map("retry_exhausted")
  versionSetFingerprint String                     @map("version_set_fingerprint") @db.Text
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  run OsvRuntimeSynchronizationRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId, stage], map: "osv_runtime_stage_attempt_run_stage_idx")
  @@index([runId, targetIdentityDigest, attemptOrdinal], map: "osv_runtime_stage_attempt_target_ordinal_idx")
  @@index([retryNotBefore], map: "osv_runtime_stage_attempt_retry_not_before_idx")
  @@index([runId, state], map: "osv_runtime_stage_attempt_run_state_idx")
  @@map("osv_runtime_stage_attempt")
}

/// Session 13 Batch 2B canary-scoped instance-operator identity. Global,
/// instance-owned, tenant-independent. The primary key is the configured
/// attestation UUID v4. No password, token, certificate, session, tenant User,
/// or Organization relation. Identity facts are immutable; status may move
/// once from active to revoked. Schema only; authentication is not implemented.
model OsvCanaryInstanceOperatorIdentity {
  id                    String                          @id @db.Uuid
  identitySchemaVersion String                          @map("identity_schema_version") @db.VarChar(128)
  identityType          String                          @map("identity_type") @db.VarChar(64)
  authenticationSource  String                          @map("authentication_source") @db.VarChar(128)
  provenanceIdentifier  String                          @map("provenance_identifier") @db.VarChar(128)
  displayLabel          String                          @map("display_label") @db.VarChar(64)
  establishedAt         DateTime                        @default(now()) @map("established_at") @db.Timestamptz(6)
  status                OsvCanaryOperatorIdentityStatus
  revokedAt             DateTime?                       @map("revoked_at") @db.Timestamptz(6)
  createdAt             DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)

  issuedAuthorizations                    OsvCanaryAuthorization[]                    @relation("OsvCanaryAuthorizationIssuer")
  revokedAuthorizations                   OsvCanaryAuthorization[]                    @relation("OsvCanaryAuthorizationRevoker")
  issuedProviderContactAuthorizations     OsvListingProviderContactAuthorization[]    @relation("OsvListingProviderContactAuthorizationIssuer")
  revokedProviderContactAuthorizations    OsvListingProviderContactAuthorization[]    @relation("OsvListingProviderContactAuthorizationRevoker")
  issuedProviderFreePreflightAttestations OsvCanaryProviderFreePreflightAttestation[] @relation("OsvCanaryProviderFreePreflightAttestationOperator")

  @@index([status], map: "osv_canary_operator_identity_status_idx")
  @@map("osv_canary_instance_operator_identity")
}

/// Session 13 Batch 2B / 2B-R immutable one-shot OSV canary authorization.
/// Global, instance-owned. One row authorizes exactly one phase. Listing-only
/// cannot store body-selection or listing-review fields. Bounded-body requires
/// accepted listing-review evidence bound to a completed listing_only row whose
/// consumed request and run match. One listing authorization may authorize one
/// bounded-body row. Consumption binds one canary request and its run. DELETE
/// is forbidden. Schema only; no issuance, consumption, CLI, heartbeat, or
/// provider contact.
model OsvCanaryAuthorization {
  id                 String @id @db.Uuid
  operatorIdentityId String @map("operator_identity_id") @db.Uuid

  authorizationSchemaVersion     String                          @map("authorization_schema_version") @db.VarChar(128)
  canaryArchitectureIdentifier   String                          @map("canary_architecture_identifier") @db.VarChar(128)
  runtimeArchitectureIdentifier  String                          @map("runtime_architecture_identifier") @db.VarChar(128)
  listingProtocolIdentifier      String                          @map("listing_protocol_identifier") @db.VarChar(128)
  actorKind                      String                          @map("actor_kind") @db.VarChar(64)
  phase                          OsvCanaryPhase
  synchronizationReason          OsvRuntimeSynchronizationReason @map("synchronization_reason")
  authorizationPurpose           OsvCanaryAuthorizationPurpose   @map("authorization_purpose")
  providerPrefix                 String                          @map("provider_prefix") @db.VarChar(32)
  sourceIdentifier               String                          @map("source_identifier") @db.VarChar(128)
  family                         String                          @db.VarChar(32)
  canaryPolicyIdentifier         String                          @map("canary_policy_identifier") @db.VarChar(128)
  workScope                      OsvRuntimeWorkScope             @map("work_scope")
  leaseScope                     String                          @map("lease_scope") @db.VarChar(128)
  runtimeVersionSetFingerprint   String                          @map("runtime_version_set_fingerprint") @db.Text
  budgetProfileIdentifier        String                          @map("budget_profile_identifier") @db.VarChar(128)
  unusedTtlSeconds               Int                             @map("unused_ttl_seconds")
  singleUsePolicy                String                          @map("single_use_policy") @db.VarChar(32)
  catalogActivationAuthorization String                          @map("catalog_activation_authorization") @db.VarChar(32)
  matchingAuthorization          String                          @map("matching_authorization") @db.VarChar(32)
  findingAuthorization           String                          @map("finding_authorization") @db.VarChar(32)
  postcanaryReviewRequirement    String                          @map("postcanary_review_requirement") @db.VarChar(32)

  legalDecisionReferenceIdentifier    String                           @map("legal_decision_reference_identifier") @db.VarChar(128)
  legalDecisionId                     String                           @map("legal_decision_id") @db.Uuid
  legalDecisionSourceRegistryVersion  String                           @map("legal_decision_source_registry_version") @db.VarChar(128)
  legalDecisionPhase                  OsvCanaryPhase                   @map("legal_decision_phase")
  legalDecisionPermittedOperation     OsvCanaryLegalPermittedOperation @map("legal_decision_permitted_operation")
  legalDecisionState                  String                           @map("legal_decision_state") @db.VarChar(128)
  legalDecisionIssuance               String                           @map("legal_decision_issuance") @db.VarChar(128)
  legalDecisionIssuedAt               DateTime                         @map("legal_decision_issued_at") @db.Timestamptz(6)
  legalDecisionRevalidationBoundaryAt DateTime                         @map("legal_decision_revalidation_boundary_at") @db.Timestamptz(6)
  legalDecisionResponsibleRole        String                           @map("legal_decision_responsible_role") @db.VarChar(128)
  legalDecisionEvidenceSetId          String                           @map("legal_decision_evidence_set_id") @db.Uuid

  bodyLegalDecisionId                     String?                           @map("body_legal_decision_id") @db.Uuid
  bodyLegalDecisionPhase                  OsvCanaryPhase?                   @map("body_legal_decision_phase")
  bodyLegalDecisionPermittedOperation     OsvCanaryLegalPermittedOperation? @map("body_legal_decision_permitted_operation")
  bodyLegalDecisionIssuedAt               DateTime?                         @map("body_legal_decision_issued_at") @db.Timestamptz(6)
  bodyLegalDecisionRevalidationBoundaryAt DateTime?                         @map("body_legal_decision_revalidation_boundary_at") @db.Timestamptz(6)
  bodyLegalDecisionEvidenceSetId          String?                           @map("body_legal_decision_evidence_set_id") @db.Uuid
  bodyRetrieveDisposition                 String?                           @map("body_retrieve_disposition") @db.VarChar(128)
  bodyTransientInspectionDisposition      String?                           @map("body_transient_inspection_disposition") @db.VarChar(128)
  bodyPrivateRetentionDisposition         String?                           @map("body_private_retention_disposition") @db.VarChar(128)
  bodyParseDisposition                    String?                           @map("body_parse_disposition") @db.VarChar(128)
  bodyExternalExposureDisposition         String?                           @map("body_external_exposure_disposition") @db.VarChar(128)
  bodyMatchingDisposition                 String?                           @map("body_matching_disposition") @db.VarChar(128)

  listingReviewEvidenceIdentifier     String?                        @map("listing_review_evidence_identifier") @db.VarChar(128)
  listingReviewId                     String?                        @map("listing_review_id") @db.Uuid
  listingAuthorizationId              String?                        @map("listing_authorization_id") @db.Uuid
  listingRequestId                    String?                        @map("listing_request_id") @db.Uuid
  listingRunId                        String?                        @map("listing_run_id") @db.Uuid
  listingCanonicalInventoryEvidenceId String?                        @map("listing_canonical_inventory_evidence_id") @db.Uuid
  listingReviewVerdict                OsvCanaryListingReviewVerdict? @map("listing_review_verdict")
  listingReviewedAt                   DateTime?                      @map("listing_reviewed_at") @db.Timestamptz(6)
  listingReviewerRole                 String?                        @map("listing_reviewer_role") @db.VarChar(128)
  bodySelectionAlgorithmIdentifier    String?                        @map("body_selection_algorithm_identifier") @db.VarChar(128)

  runbookSetIdentifier            String   @map("runbook_set_identifier") @db.VarChar(128)
  runbookVersion                  String   @map("runbook_version") @db.VarChar(128)
  runbookAcknowledgedAt           DateTime @map("runbook_acknowledged_at") @db.Timestamptz(6)
  runbookEmergencyHaltProcedure   String   @map("runbook_emergency_halt_procedure") @db.VarChar(128)
  haltAcknowledgementIdentifier   String   @map("halt_acknowledgement_identifier") @db.VarChar(128)
  haltAcknowledgedAt              DateTime @map("halt_acknowledged_at") @db.Timestamptz(6)
  activationProhibitionIdentifier String   @map("activation_prohibition_identifier") @db.VarChar(128)
  retryProhibitionIdentifier      String   @map("retry_prohibition_identifier") @db.VarChar(128)

  issuedAt                           DateTime                     @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt                          DateTime                     @map("expires_at") @db.Timestamptz(6)
  state                              OsvCanaryAuthorizationState
  consumedAt                         DateTime?                    @map("consumed_at") @db.Timestamptz(6)
  consumedBySynchronizationRequestId String?                      @map("consumed_by_synchronization_request_id") @db.Uuid
  consumedBySynchronizationRunId     String?                      @map("consumed_by_synchronization_run_id") @db.Uuid
  terminalAt                         DateTime?                    @map("terminal_at") @db.Timestamptz(6)
  terminalDisposition                OsvCanaryAuthorizationState? @map("terminal_disposition")
  terminalReasonCode                 String?                      @map("terminal_reason_code") @db.VarChar(64)
  revokedAt                          DateTime?                    @map("revoked_at") @db.Timestamptz(6)
  revokedByOperatorIdentityId        String?                      @map("revoked_by_operator_identity_id") @db.Uuid
  createdAt                          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  operatorIdentity                     OsvCanaryInstanceOperatorIdentity           @relation("OsvCanaryAuthorizationIssuer", fields: [operatorIdentityId], references: [id], onDelete: Restrict)
  revokedByOperatorIdentity            OsvCanaryInstanceOperatorIdentity?          @relation("OsvCanaryAuthorizationRevoker", fields: [revokedByOperatorIdentityId], references: [id], onDelete: Restrict)
  listingAuthorization                 OsvCanaryAuthorization?                     @relation("OsvCanaryAuthorizationListingReview", fields: [listingAuthorizationId], references: [id], onDelete: Restrict)
  boundedBodyAuthorizations            OsvCanaryAuthorization[]                    @relation("OsvCanaryAuthorizationListingReview")
  listingRequest                       OsvRuntimeSynchronizationRequest?           @relation("OsvCanaryAuthorizationListingRequest", fields: [listingRequestId], references: [id], onDelete: Restrict)
  listingRun                           OsvRuntimeSynchronizationRun?               @relation("OsvCanaryAuthorizationListingRun", fields: [listingRunId], references: [id], onDelete: Restrict)
  consumedRequest                      OsvRuntimeSynchronizationRequest?           @relation("OsvCanaryAuthorizationConsumedRequest", fields: [consumedBySynchronizationRequestId, workScope, synchronizationReason, runtimeVersionSetFingerprint, leaseScope], references: [id, workScope, synchronizationReason, versionSetFingerprint, leaseScope], onDelete: Restrict)
  consumedRun                          OsvRuntimeSynchronizationRun?               @relation("OsvCanaryAuthorizationConsumedRun", fields: [consumedBySynchronizationRunId, consumedBySynchronizationRequestId], references: [id, requestId], onDelete: Restrict)
  listingProviderContactAuthorizations OsvListingProviderContactAuthorization[]    @relation("OsvListingProviderContactSourceAuthorization")
  providerFreePreflightAttestations    OsvCanaryProviderFreePreflightAttestation[] @relation("OsvCanaryProviderFreePreflightSourceAuthorization")

  @@index([state, expiresAt], map: "osv_canary_authorization_state_expires_idx")
  @@index([operatorIdentityId, issuedAt], map: "osv_canary_authorization_operator_issued_idx")
  @@index([consumedBySynchronizationRequestId], map: "osv_canary_authorization_consumed_request_idx")
  @@index([consumedBySynchronizationRunId], map: "osv_canary_authorization_consumed_run_idx")
  @@index([phase, state], map: "osv_canary_authorization_phase_state_idx")
  @@index([revokedByOperatorIdentityId], map: "osv_canary_authorization_revoker_idx")
  @@map("osv_canary_authorization")
}

/// Session 13 Batch 3B-P / 3B-P-R durable accepted provider-free preflight
/// attestation. Global, instance-owned. Pins the Batch 2F success outcome
/// that provider contact remained unauthorized. Not a complete readiness
/// payload and not arbitrary JSON. INSERT-once and DELETE-forbidden. Insert
/// requires an active operator and a consumed listing-only source whose
/// provider, prefix, budget, request, run, and fingerprint match.
/// captured_at and created_at cannot be after database now. Schema only.
model OsvCanaryProviderFreePreflightAttestation {
  id String @id @db.Uuid

  evidenceSchemaVersion          String                          @map("evidence_schema_version") @db.VarChar(128)
  sourceCanaryAuthorizationId    String                          @map("source_canary_authorization_id") @db.Uuid
  operatorIdentityId             String                          @map("operator_identity_id") @db.Uuid
  synchronizationRequestId       String                          @map("synchronization_request_id") @db.Uuid
  synchronizationRunId           String                          @map("synchronization_run_id") @db.Uuid
  /// Closed identifier listing_only. SQL CHECK rejects any other phase.
  phase                          String                          @db.VarChar(32)
  providerIdentity               String                          @map("provider_identity") @db.VarChar(128)
  approvedPrefix                 String                          @map("approved_prefix") @db.VarChar(32)
  canaryPolicyIdentifier         String                          @map("canary_policy_identifier") @db.VarChar(128)
  listingBudgetProfile           String                          @map("listing_budget_profile") @db.VarChar(128)
  workScope                      OsvRuntimeWorkScope             @map("work_scope")
  leaseScope                     String                          @map("lease_scope") @db.VarChar(128)
  synchronizationReason          OsvRuntimeSynchronizationReason @map("synchronization_reason")
  runtimeVersionSetFingerprint   String                          @map("runtime_version_set_fingerprint") @db.Text
  legalDecisionVersion           String                          @map("legal_decision_version") @db.VarChar(128)
  egressEvidenceVersion          String                          @map("egress_evidence_version") @db.VarChar(128)
  heartbeatPolicyIdentifier      String                          @map("heartbeat_policy_identifier") @db.VarChar(128)
  deadlinePolicyIdentifier       String                          @map("deadline_policy_identifier") @db.VarChar(128)
  activePointerBaselineIdentity  String                          @map("active_pointer_baseline_identity") @db.Uuid
  zeroFindingBaselineIdentity    String                          @map("zero_finding_baseline_identity") @db.Uuid
  outcome                        String                          @db.VarChar(128)
  providerContactAuthorized      Boolean                         @map("provider_contact_authorized")
  executionPermitted             Boolean                         @map("execution_permitted")
  acceptedForProviderContactAuth Boolean                         @map("accepted_for_provider_contact_authorization")
  capturedAt                     DateTime                        @map("captured_at") @db.Timestamptz(6)
  createdAt                      DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)

  sourceCanaryAuthorization           OsvCanaryAuthorization                  @relation("OsvCanaryProviderFreePreflightSourceAuthorization", fields: [sourceCanaryAuthorizationId], references: [id], onDelete: Restrict, map: "osv_canary_provider_free_preflight_source_fkey")
  operatorIdentity                    OsvCanaryInstanceOperatorIdentity       @relation("OsvCanaryProviderFreePreflightAttestationOperator", fields: [operatorIdentityId], references: [id], onDelete: Restrict, map: "osv_canary_provider_free_preflight_operator_fkey")
  synchronizationRequest              OsvRuntimeSynchronizationRequest        @relation("OsvCanaryProviderFreePreflightRequest", fields: [synchronizationRequestId, workScope, synchronizationReason, runtimeVersionSetFingerprint, leaseScope], references: [id, workScope, synchronizationReason, versionSetFingerprint, leaseScope], onDelete: Restrict, map: "osv_canary_provider_free_preflight_request_fkey")
  synchronizationRun                  OsvRuntimeSynchronizationRun            @relation("OsvCanaryProviderFreePreflightRun", fields: [synchronizationRunId, synchronizationRequestId], references: [id, requestId], onDelete: Restrict, map: "osv_canary_provider_free_preflight_run_fkey")
  listingProviderContactAuthorization OsvListingProviderContactAuthorization?

  @@unique([sourceCanaryAuthorizationId], map: "osv_canary_provider_free_preflight_source_uidx")
