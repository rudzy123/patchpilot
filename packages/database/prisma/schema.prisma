/// Session 11 Batch 5C OSV acquisition foundation. Global, instance-owned.
/// Body bytes remain outside PostgreSQL. No tenant or Finding foreign keys.
/// Mapping notes: validated provider keys are stored on OsvProviderObject for
/// generation-bound retrieval in addition to the public digest/prefix/family
/// identity; completeness is one row per dimension; activation request and
/// result share OsvActivationRecord. Parser attempt/revision insert order is
/// attempt (null revision), then revision, then attempt.parsedRevisionId.
model OsvCatalogGeneration {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scopeFingerprint      String                   @map("scope_fingerprint") @db.Char(64)
  providerIdentifier    String                   @map("provider_identifier") @db.VarChar(32)
  inventoryScope        String                   @map("inventory_scope") @db.VarChar(128)
  eligibleBodyScope     String                   @map("eligible_body_scope") @db.VarChar(128)
  sourceLicenseRegistry String                   @map("source_license_registry") @db.VarChar(128)
  listingProtocol       String                   @map("listing_protocol") @db.VarChar(128)
  transportPolicy       String                   @map("transport_policy") @db.VarChar(128)
  parserProtocol        String                   @map("parser_protocol") @db.VarChar(128)
  parserResourcePolicy  String                   @map("parser_resource_policy") @db.VarChar(128)
  schemaRevision        String                   @map("schema_revision") @db.VarChar(32)
  schemaCommit          String                   @map("schema_commit") @db.Char(40)
  metadataPolicy        String                   @map("metadata_policy") @db.VarChar(128)
  syncAlgorithm         String                   @map("sync_algorithm") @db.VarChar(128)
  lifecycleState        OsvCatalogLifecycleState @default(planned) @map("lifecycle_state")
  version               Int                      @default(1)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  readyAt               DateTime?                @map("ready_at") @db.Timestamptz(6)
  activatedAt           DateTime?                @map("activated_at") @db.Timestamptz(6)
  supersededAt          DateTime?                @map("superseded_at") @db.Timestamptz(6)
  failedAt              DateTime?                @map("failed_at") @db.Timestamptz(6)
  cancelledAt           DateTime?                @map("cancelled_at") @db.Timestamptz(6)
  quarantinedAt         DateTime?                @map("quarantined_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  acquisitionRuns        OsvAcquisitionRun[]
  inventoryRuns          OsvInventoryRun[]
  completenessRows       OsvAcquisitionCompleteness[]
  reconciliation         OsvReconciliation?
  memberships            OsvCatalogMembership[]
  quarantineRecords      OsvQuarantineRecord[]
  presenceObservations   OsvProviderPresenceObservation[]
  activePointers         OsvActiveCatalogPointer[]
  activationsAsCandidate OsvActivationRecord[]            @relation("OsvActivationCandidate")
  activationsAsPrevious  OsvActivationRecord[]            @relation("OsvActivationPrevious")

  @@unique([id, scopeFingerprint], map: "osv_catalog_generation_id_scope_key")
  @@index([scopeFingerprint, lifecycleState], map: "osv_catalog_generation_scope_state_idx")
  @@map("osv_catalog_generation")
}

