  entry KevEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@unique([entryId, ordinal], map: "kev_entry_cwe_ordinal_uidx")
  @@unique([entryId, normalizedCwe], map: "kev_entry_cwe_value_uidx")
  @@map("kev_entry_cwe")
}

model Integration {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  providerId           String           @map("provider_id") @db.Uuid
  displayName          String           @map("display_name") @db.VarChar(200)
  state                IntegrationState @default(disabled)
  /// Non-secret configuration. schemaVersion required. No tokens.
  config               Json
  externalAccountId    String?          @map("external_account_id") @db.VarChar(256)
  lastSuccessfulSyncAt DateTime?        @map("last_successful_sync_at") @db.Timestamptz(6)
  lastFailureAt        DateTime?        @map("last_failure_at") @db.Timestamptz(6)
  version              Int              @default(1)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
