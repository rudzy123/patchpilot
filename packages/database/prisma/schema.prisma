  /// Restricted. nonce_12 || ciphertext || tag_16. Public queries must omit.
  protectedIdentityEnvelope      Bytes? @map("protected_identity_envelope") @db.ByteA
  rowRevision                    BigInt @map("row_revision")
  createdAt                      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  rotationRecordedAt             DateTime? @map("rotation_recorded_at") @db.Timestamptz(6)
  erasureAttemptedAt             DateTime? @map("erasure_attempted_at") @db.Timestamptz(6)
  erasureCompletedAt             DateTime? @map("erasure_completed_at") @db.Timestamptz(6)

  observation OsvListingObservationEvidence    @relation(fields: [observationId, evidenceSetId, providerGeneration, declaredListingByteCount, sourceFamilyClassification, classificationStatus], references: [id, evidenceSetId, providerGeneration, declaredListingByteCount, sourceFamilyClassification, classificationStatus], onDelete: Restrict, map: "osv_listing_observation_evidence_envelope_observation_fkey")
  evidenceSet OsvListingObservationEvidenceSet @relation(fields: [evidenceSetId], references: [id], onDelete: Restrict, map: "osv_listing_observation_evidence_envelope_set_fkey")

  @@unique([observationId, envelopeOrdinal], map: "osv_listing_observation_evidence_envelope_ordinal_uidx")
  @@index([evidenceSetId, envelopeState], map: "osv_listing_observation_evidence_envelope_set_state_idx")
  @@index([observationId, envelopeState], map: "osv_listing_observation_evidence_envelope_observation_state_idx")
  @@map("osv_listing_observation_evidence_envelope")
}

/// Session 13 Batch 3D-S append-only purge evidence. Does not store ciphertext,
/// key material, or provider identity. DELETE forbidden. Successful purge
/// redacts envelope BYTEA columns and retains observation metadata.
model OsvListingObservationEvidencePurge {
  id String @id @db.Uuid

  evidenceSetId                    String @map("evidence_set_id") @db.Uuid
  purgeAuthorizationClassification String @map("purge_authorization_classification") @db.VarChar(128)
  purgeReasonCode                  String @map("purge_reason_code") @db.VarChar(64)
  legalHoldDecision                String @map("legal_hold_decision") @db.VarChar(64)
  dependentAuthorityTerminalDecision String @map("dependent_authority_terminal_decision") @db.VarChar(64)
  erasureMechanismClassification   String @map("erasure_mechanism_classification") @db.VarChar(128)
  erasureOutcome                   OsvListingObservationPurgeErasureOutcome @map("erasure_outcome")
  attemptedAt                      DateTime @default(now()) @map("attempted_at") @db.Timestamptz(6)
  completedAt                      DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt                        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  evidenceSet OsvListingObservationEvidenceSet @relation(fields: [evidenceSetId], references: [id], onDelete: Restrict, map: "osv_listing_observation_evidence_purge_set_fkey")

  @@index([evidenceSetId], map: "osv_listing_observation_evidence_purge_set_idx")
  @@map("osv_listing_observation_evidence_purge")
}

model Integration {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  providerId           String           @map("provider_id") @db.Uuid
  displayName          String           @map("display_name") @db.VarChar(200)
  state                IntegrationState @default(disabled)
  /// Non-secret configuration. schemaVersion required. No tokens.
  config               Json
  externalAccountId    String?          @map("external_account_id") @db.VarChar(256)
  lastSuccessfulSyncAt DateTime?        @map("last_successful_sync_at") @db.Timestamptz(6)
  lastFailureAt        DateTime?        @map("last_failure_at") @db.Timestamptz(6)
  version              Int              @default(1)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  provider              IntegrationProvider    @relation(fields: [providerId], references: [id], onDelete: Restrict)
  credentials           ExternalCredential[]
  repositoryConnections RepositoryConnection[]

  @@unique([organizationId, id], map: "integration_org_id_key")
  @@unique([organizationId, providerId], map: "integration_org_provider_key")
  @@index([organizationId, state], map: "integration_org_state_idx")
  @@map("integration")
}

model ExternalCredential {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                   @map("organization_id") @db.Uuid
  integrationId   String                   @map("integration_id") @db.Uuid
  storageProvider SecretStorageProvider    @map("storage_provider")
  secretReference String                   @map("secret_reference") @db.VarChar(512)
  keyVersion      String                   @map("key_version") @db.VarChar(128)
  status          ExternalCredentialStatus @default(pending)
  expiresAt       DateTime?                @map("expires_at") @db.Timestamptz(6)
  rotatedAt       DateTime?                @map("rotated_at") @db.Timestamptz(6)
  version         Int                      @default(1)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  integration  Integration  @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "external_credential_org_id_key")
  @@index([organizationId, integrationId], map: "external_credential_org_integration_idx")
  @@map("external_credential")
}

model OutboxEvent {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String?           @map("organization_id") @db.Uuid
  aggregateType       String            @map("aggregate_type") @db.VarChar(64)
  aggregateId         String            @map("aggregate_id") @db.Uuid
  eventType           String            @map("event_type") @db.VarChar(128)
  eventSchemaVersion  Int               @map("event_schema_version")
  /// Opaque IDs and safe metadata only. schemaVersion required. No SBOM bodies, tokens, or provider payloads.
  payload             Json
  dedupeKey           String            @map("dedupe_key") @db.VarChar(256)
  occurredAt          DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt         DateTime          @default(now()) @map("available_at") @db.Timestamptz(6)
  claimedAt           DateTime?         @map("claimed_at") @db.Timestamptz(6)
  leaseExpiresAt      DateTime?         @map("lease_expires_at") @db.Timestamptz(6)
  processedAt         DateTime?         @map("processed_at") @db.Timestamptz(6)
  attemptCount        Int               @default(0) @map("attempt_count")
  lastFailureCategory String?           @map("last_failure_category") @db.VarChar(64)
  lastFailureCode     String?           @map("last_failure_code") @db.VarChar(64)
  status              OutboxEventStatus @default(pending)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  backgroundJobs BackgroundJob[]

  @@unique([organizationId, id], map: "outbox_event_org_id_key")
  @@index([status, availableAt], map: "outbox_event_claim_idx")
  @@index([organizationId, eventType], map: "outbox_event_org_type_idx")
  @@map("outbox_event")
}

model BackgroundJob {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String?             @map("organization_id") @db.Uuid
  outboxEventId    String?             @map("outbox_event_id") @db.Uuid
  jobType          String              @map("job_type") @db.VarChar(128)
  status           BackgroundJobStatus @default(pending)
  attempt          Int                 @default(0)
  startedAt        DateTime?           @map("started_at") @db.Timestamptz(6)
  leaseExpiresAt   DateTime?           @map("lease_expires_at") @db.Timestamptz(6)
  completedAt      DateTime?           @map("completed_at") @db.Timestamptz(6)
  failureCategory  String?             @map("failure_category") @db.VarChar(64)
  failureCode      String?             @map("failure_code") @db.VarChar(64)
  workerIdentifier String?             @map("worker_identifier") @db.VarChar(128)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  outboxEvent  OutboxEvent?  @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)

  @@unique([outboxEventId], map: "background_job_outbox_event_uidx")
  @@index([organizationId, status], map: "background_job_org_status_idx")
  @@index([status, leaseExpiresAt], map: "background_job_lease_idx")
  @@index([outboxEventId], map: "background_job_outbox_idx")
  @@map("background_job")
}

model IdempotencyRecord {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  scope              String                  @db.VarChar(128)
  keyHash            String                  @map("key_hash") @db.Char(64)
  requestFingerprint String                  @map("request_fingerprint") @db.Char(64)
  status             IdempotencyRecordStatus @default(started)
  responseStatus     Int?                    @map("response_status")
  /// Bounded safe response metadata. schemaVersion required. No bearer tokens or raw keys.
  response           Json?
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt          DateTime                @map("expires_at") @db.Timestamptz(6)
  completedAt        DateTime?               @map("completed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scope, keyHash], map: "idempotency_record_org_scope_key")
  @@index([expiresAt], map: "idempotency_record_expires_idx")
  @@map("idempotency_record")
}
