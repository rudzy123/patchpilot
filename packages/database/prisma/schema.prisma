model OutboxEvent {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String?           @map("organization_id") @db.Uuid
  aggregateType       String            @map("aggregate_type") @db.VarChar(64)
  aggregateId         String            @map("aggregate_id") @db.Uuid
  eventType           String            @map("event_type") @db.VarChar(128)
  eventSchemaVersion  Int               @map("event_schema_version")
  /// Opaque IDs and safe metadata only. schemaVersion required. No SBOM bodies, tokens, or provider payloads.
  payload             Json
  dedupeKey           String            @map("dedupe_key") @db.VarChar(256)
  occurredAt          DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt         DateTime          @default(now()) @map("available_at") @db.Timestamptz(6)
  claimedAt           DateTime?         @map("claimed_at") @db.Timestamptz(6)
  leaseExpiresAt      DateTime?         @map("lease_expires_at") @db.Timestamptz(6)
  processedAt         DateTime?         @map("processed_at") @db.Timestamptz(6)
  attemptCount        Int               @default(0) @map("attempt_count")
  lastFailureCategory String?           @map("last_failure_category") @db.VarChar(64)
  lastFailureCode     String?           @map("last_failure_code") @db.VarChar(64)
  status              OutboxEventStatus @default(pending)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  backgroundJobs BackgroundJob[]

  @@unique([organizationId, id], map: "outbox_event_org_id_key")
  @@index([status, availableAt], map: "outbox_event_claim_idx")
  @@index([organizationId, eventType], map: "outbox_event_org_type_idx")
  @@map("outbox_event")
}

model BackgroundJob {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String?             @map("organization_id") @db.Uuid
  outboxEventId    String?             @map("outbox_event_id") @db.Uuid
  jobType          String              @map("job_type") @db.VarChar(128)
  status           BackgroundJobStatus @default(pending)
  attempt          Int                 @default(0)
  startedAt        DateTime?           @map("started_at") @db.Timestamptz(6)
  leaseExpiresAt   DateTime?           @map("lease_expires_at") @db.Timestamptz(6)
  completedAt      DateTime?           @map("completed_at") @db.Timestamptz(6)
  failureCategory  String?             @map("failure_category") @db.VarChar(64)
  failureCode      String?             @map("failure_code") @db.VarChar(64)
  workerIdentifier String?             @map("worker_identifier") @db.VarChar(128)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  outboxEvent  OutboxEvent?  @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)

  @@unique([outboxEventId], map: "background_job_outbox_event_uidx")
  @@index([organizationId, status], map: "background_job_org_status_idx")
  @@index([status, leaseExpiresAt], map: "background_job_lease_idx")
  @@index([outboxEventId], map: "background_job_outbox_idx")
  @@map("background_job")
}

model IdempotencyRecord {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                   @map("organization_id") @db.Uuid
  scope              String                   @db.VarChar(128)
  keyHash            String                   @map("key_hash") @db.Char(64)
  requestFingerprint String                   @map("request_fingerprint") @db.Char(64)
  status             IdempotencyRecordStatus  @default(started)
  responseStatus     Int?                     @map("response_status")
  /// Bounded safe response metadata. schemaVersion required. No bearer tokens or raw keys.
  response           Json?
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt          DateTime                 @map("expires_at") @db.Timestamptz(6)
  completedAt        DateTime?                @map("completed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scope, keyHash], map: "idempotency_record_org_scope_key")
  @@index([expiresAt], map: "idempotency_record_expires_idx")
  @@map("idempotency_record")
}
