  cryptographicPolicyId          String @map("cryptographic_policy_id") @db.VarChar(128)
  algorithmId                    String @map("algorithm_id") @db.VarChar(32)
  associatedDataPolicyId         String @map("associated_data_policy_id") @db.VarChar(128)
  opaqueKeyAlias                 String @map("opaque_key_alias") @db.VarChar(64)
