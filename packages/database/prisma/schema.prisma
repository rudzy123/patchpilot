  @@unique([generationId, normalizedCve], map: "kev_entry_generation_cve_uidx")
  @@unique([generationId, ordinal], map: "kev_entry_generation_ordinal_uidx")
  @@index([generationId, ordinal, id], map: "kev_entry_generation_ordinal_id_idx")
  @@map("kev_entry")
}

model KevEntryCwe {
