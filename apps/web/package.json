{
  "name": "@patchpilot/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js App Router presentation. Landing, Session 6 authentication, and Session 7 asset inventory UI.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "NEXT_PUBLIC_PATCHPILOT_ENVIRONMENT=\"${NEXT_PUBLIC_PATCHPILOT_ENVIRONMENT:-development}\" NEXT_PUBLIC_API_BASE_URL=\"${NEXT_PUBLIC_API_BASE_URL:-http://127.0.0.1:3001}\" next dev --port 3000 --hostname 127.0.0.1",
    "build": "NEXT_PUBLIC_PATCHPILOT_ENVIRONMENT=\"${NEXT_PUBLIC_PATCHPILOT_ENVIRONMENT:-production}\" NEXT_PUBLIC_API_BASE_URL=\"${NEXT_PUBLIC_API_BASE_URL:-https://api.patchpilot.example}\" next build",
    "start": "NEXT_PUBLIC_PATCHPILOT_ENVIRONMENT=\"${NEXT_PUBLIC_PATCHPILOT_ENVIRONMENT:-production}\" NEXT_PUBLIC_API_BASE_URL=\"${NEXT_PUBLIC_API_BASE_URL:-https://api.patchpilot.example}\" next start --port 3000 --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "node ../../scripts/report-e2e-not-wired.mjs",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@patchpilot/config": "workspace:*",
    "@patchpilot/contracts": "workspace:*",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@patchpilot/eslint-config": "workspace:*",
    "@patchpilot/typescript-config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
