{
  "name": "@patchpilot/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify HTTP API. Health, Session 6 authentication, and Session 7 asset inventory routes.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "11.2.0",
    "@patchpilot/auth": "workspace:*",
    "@patchpilot/config": "workspace:*",
    "@patchpilot/contracts": "workspace:*",
    "@patchpilot/database": "workspace:*",
    "@patchpilot/domain": "workspace:*",
    "@patchpilot/logger": "workspace:*",
    "@patchpilot/observability": "workspace:*",
    "fastify": "^5.6.2",
    "ioredis": "^5.8.2"
  },
  "devDependencies": {
    "@patchpilot/eslint-config": "workspace:*",
    "@patchpilot/test-utils": "workspace:*",
    "@patchpilot/typescript-config": "workspace:*",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
