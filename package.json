{
  "name": "patchpilot",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted vulnerability prioritization and remediation. Development foundation only.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.24.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "infrastructure:up": "node scripts/run-infrastructure.mjs up",
    "infrastructure:down": "node scripts/run-infrastructure.mjs down",
    "infrastructure:status": "node scripts/run-infrastructure.mjs status",
    "infrastructure:logs": "node scripts/run-infrastructure.mjs logs",
    "db:generate": "node scripts/run-database-command.mjs generate",
    "db:validate": "node scripts/run-database-command.mjs validate",
    "db:migrate": "node scripts/run-database-command.mjs migrate",
    "db:migrate:deploy": "node scripts/run-database-command.mjs migrate:deploy",
    "db:reset": "node scripts/run-database-command.mjs reset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && turbo run lint",
    "lint:fix": "eslint . --fix && turbo run lint -- --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "test": "pnpm test:unit",
    "test:unit": "turbo run test:unit && node --test scripts/*.test.mjs",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "build": "turbo run build",
    "workflows:lint": "node scripts/lint-workflows.mjs",
    "clean": "turbo run clean && node scripts/clean-root.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@patchpilot/eslint-config": "workspace:*",
    "@patchpilot/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.9.6",
    "turbo": "^2.8.12",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.11"
  }
}
